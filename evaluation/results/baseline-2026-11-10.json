      "sql": "SELECT \n    dim_product.category AS 品类,\n    SUM(fact_orders.order_amount) AS 销售额,\n    SUM(fact_payments.payment_amount) FILTER (WHERE fact_payments.status = 'REFUNDED') AS 退款金额\nFROM fact_orders\nLEFT JOIN dim_product ON fact_orders.product_id = dim_product.product_id\nLEFT JOIN fact_payments ON fact_orders.order_id = fact_payments.order_id\nLEFT JOIN dim_date ON fact_orders.order_date = dim_date.full_date\nWHERE dim_date.year = 2024\nGROUP BY dim_product.category",
      "golden_sql": "WITH sales AS (  SELECT p.category AS category, SUM(o.order_amount) AS amount   FROM fact_orders o JOIN dim_product p ON p.product_id = o.product_id   JOIN dim_date d ON d.full_date = o.order_date   WHERE d.year = 2024 GROUP BY p.category), refunds AS (  SELECT p.category AS category, SUM(pay.payment_amount) AS amount   FROM fact_payments pay JOIN fact_orders o ON o.order_id = pay.order_id   JOIN dim_product p ON p.product_id = o.product_id   JOIN dim_date d ON d.full_date = o.order_date   WHERE d.year = 2024 AND pay.status = 'REFUNDED' GROUP BY p.category) SELECT s.category AS category, ROUND(s.amount, 2) AS sales, ROUND(COALESCE(r.amount, 0), 2) AS refund FROM sales s LEFT JOIN refunds r ON r.category = s.category ORDER BY sales DESC"
    },
