      "sql": "SELECT \n    dim_date.month AS 月份,\n    SUM(fact_orders.order_amount) AS 销售额\nFROM \n    fact_orders\nLEFT JOIN \n    dim_date ON dim_date.full_date = fact_orders.order_date\nLEFT JOIN \n    dim_store ON fact_orders.store_id = dim_store.store_id\nWHERE \n    dim_date.year = 2024\n    AND dim_store.region = '华南'\nGROUP BY \n    dim_date.month\nORDER BY \n    dim_date.month",
      "golden_sql": "SELECT d.month AS month, ROUND(SUM(o.order_amount), 2) AS sales FROM fact_orders o JOIN dim_store s ON o.store_id = s.store_id JOIN dim_date d ON d.full_date = o.order_date WHERE d.year = 2024 AND s.region = '华南' GROUP BY d.month ORDER BY d.month"
    }
