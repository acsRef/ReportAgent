{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:contract": "playwright test --config e2e/playwright.config.ts e2e/specs/0[1-9]-*.spec.ts e2e/specs/10-*.spec.ts",
    "e2e:contract:ci": "playwright test --config e2e/playwright.config.ts e2e/specs/0[1-4]-*.spec.ts e2e/specs/0[6-9]-*.spec.ts e2e/specs/10-*.spec.ts",
    "e2e:full": "playwright test --config e2e/playwright.config.ts e2e/specs/1[1-2]-*.spec.ts"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "immer": "^10.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^25.0.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^2.1.8"
  }
}
