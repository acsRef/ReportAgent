# 临时 e2e 后端/mcp 调试日志（手动启动时自动生成）
.e2elogs/
# 前端 Playwright 烟测截图/产物（.e2elogs 规则只匹配根目录，子目录需单独忽略）
frontend/.e2elogs/

# OS
.DS_Store
Thumbs.db

# JS
node_modules/

# Claude Code local state
.claude/

# Playwright 产物（每次运行清空重建，README 说明见 frontend/e2e/README.md）
frontend/e2e/artifacts/
# globalSetup 起 vite 时写的 pid（进程退出后残留，不该进版本库）
frontend/e2e/helpers/.e2e-vite.pid

# 评测平台的运行记录（本地 SQLite，不进库）
eval_platform/runs.sqlite

# 归档的历史运行库（批次重跑前留档，仅本地可查）
eval_platform/.archive/

# CI 本地跑出来的报告/日志（workflow 里用 artifact 收集，不进版本库）
reports/
