# ReportAgent — environment variables template
#
# Copy this file to `.env` at the repo root and fill in real values.
# Never commit `.env` to version control (it's already in .gitignore).

# ---- LLM (OpenAI-compatible) ------------------------------------------------

# Primary LLM API key. Required.
MINIMAX_API_KEY=

# Alternative key name; falls back to MINIMAX_API_KEY if absent.
LLM_API_KEY=

# LLM model identifier; OpenAI-compatible deployments accept any name.
LLM_MODEL=MiniMax-M2.7-highspeed

# LLM base URL (OpenAI-compatible mode).
LLM_BASE_URL=https://api.minimax.chat/v1


# ---- Embedding (SiliconFlow) -----------------------------------------------

# Used by QueryMemory + UserMemory for pgvector similarity search.
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1536  # Must match VECTOR(1536) in init_pg.sql
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1


# ---- Database (PostgreSQL + pgvector) --------------------------------------

# Application persistence (asyncpg pool) + LangGraph checkpoint. Superuser in
# docker dev; in production use a role that owns app/agent/memory/observability
# schemas but is NOT a Postgres superuser.
DATABASE_URL=postgresql://ragent:ragent@localhost:5432/ragent

# SQL analysis path (psycopg2 sync; runs LLM-generated SELECTs). Defaults to
# DATABASE_URL when unset. Set this to a NON-superuser role (ragent_readonly,
# created by backend/scripts/setup_app_role.sql) to defeat any leak path at
# the DB layer — check_sql_safety is one defense line; least privilege is the
# other. See docs/plans/2026-08-05-pg-role-least-privilege.md.
ANALYSIS_DSN=postgresql://ragent_readonly:ragent_readonly@localhost:5432/ragent


# ---- Memory (mem0 L3 fact extraction, optional) ----------------------------

# 分层对话上下文的 L3 事实抽取引擎开关。false（默认）→ 纯 LLM 抽取；true → 用
# mem0 自动抽取长期事实（需 mem0ai + 本地 chroma）。召回主路径始终是 pgvector
# 语义排序（LFU/LRU 作排序因子），mem0 只负责抽取、不做召回。
# 见 docs/plans/2026-08-01-memory-mechanism.md。
MEM0_ENABLED=false


# ---- Auth ------------------------------------------------------------------

# Runtime environment. The startup security gate is FAIL-CLOSED: when this is
# unset the app assumes "production" and REFUSES to start with insecure defaults.
#   development -> local dev; insecure defaults allowed (with the escape hatch below)
#   staging / production -> strict: strong JWT_SECRET + strong DEFAULT_PASSWORD
APP_ENV=development

# Development escape hatch. ONLY honored when APP_ENV=development; ignored in
# staging/production. Set to 1 to allow the dev default secret/password locally.
ALLOW_INSECURE_DEFAULT_AUTH=1

# HS256 secret for JWTs. The value below is the PUBLIC dev default and is only
# accepted when APP_ENV=development + ALLOW_INSECURE_DEFAULT_AUTH=1. In
# staging/production it MUST be a long random string (>= 32 chars) or startup fails.
JWT_SECRET=reportagent-dev-secret-key-change-in-production

# Bootstrap credentials created on first run if no users exist. 'admin123' is
# rejected outside development; an already-existing admin still holding the weak
# password also blocks startup until rotated.
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=admin123


# ---- 数据字典桥（ragent-py RAG） -------------------------------------------
# 字段/接口字典存放在 ragent-py 的专用知识库；未配置时字典检索静默降级。

# ragent-py 服务地址（如 http://localhost:8000）
RAGENT_URL=

# 服务账号（需 kb.create / doc.upload / doc.read_all 权限）
RAGENT_USER=
RAGENT_PASSWORD=

# 字典知识库名（与 ragent-py/mcp_server 的 DICT_KB_NAME 保持一致）
DICT_KB_NAME=数据字典

# ── Schema FAQ MCP client（连 ragent-py/mcp_server 调 search_faq）──
# 子进程启动参数：ragent-py 的 mcp_server 须用其 env 运行（含 mcp>=2 + mcp_server 包）。
RAGENT_MCP_PYTHON=D:/miniConda/envs/rag/python.exe
RAGENT_MCP_MODULE=mcp_server.server
RAGENT_MCP_CWD=D:/PyProject/ragent-py
# 单次 search_faq 调用超时（秒）
RAGENT_MCP_TIMEOUT=15
# FAQ 知识库名（与 ragent-py/mcp_server 的 FAQ_KB_NAME 保持一致）
FAQ_KB_NAME=FAQ
